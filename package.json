{
  "name": "mcp-file-server",
  "version": "0.1.0",
  "description": "MCP File Server (M1 skeleton)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
